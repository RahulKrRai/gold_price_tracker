# Copy this file to .env and fill in what you need. Never commit .env.

# Where the SQLite database lives
GOLD_DB_PATH=data/gold.db

# Manual fallback for today's 24K rate (INR per gram, excl. GST).
# Used when no rate has been fetched yet. 22K is derived as 24K x 0.916.
GOLD_RATE_24K=

# Optional JSON endpoint that returns the 24K rate per gram.
# GOLD_RATE_JSON_KEY is a dot path into the response, e.g. "data.rate_24k".
GOLD_RATE_URL=
GOLD_RATE_JSON_KEY=

# Which payment offers you can actually use (comma-separated offer ids from data/offers.json)
MY_OFFERS=sbi-card,cb-1350-29k

# Count first-order-only coupons? (true/false)
INCLUDE_FIRST_ORDER=false

# Refresh interval for the scheduler, in minutes (30-60 recommended)
REFRESH_MINUTES=45

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_BELOW_PER_FINE_G=
