# Copy this file to .env and fill in what you need. Never commit .env.

# Where the SQLite database lives
GOLD_DB_PATH=data/gold.db

# --- Gold rates -----------------------------------------------------------------------------
# Sources in order; the first one that has a rate is the benchmark for "vs market".
#   ibja    = official India Bullion & Jewellers Association rate (weekdays, AM and PM)
#   tanishq = Tanishq's published retail rate (what WealthyDimes uses)
#   manual  = GOLD_RATE_24K below;  url = GOLD_RATE_URL + GOLD_RATE_JSON_KEY below
GOLD_RATE_SOURCES=ibja,tanishq
# Weekday times (India time) to fetch rates
RATE_REFRESH_TIMES=11:00,17:00
GOLD_RATE_24K=
GOLD_RATE_URL=
GOLD_RATE_JSON_KEY=

# --- Prices ---------------------------------------------------------------------------------
# Retailers to collect (run on your own computer; they block cloud servers)
RETAILERS=myntra,ajio,flipkart,amazon
# Amazon: auto = Creators API when keys are set, else the browser; or force api / browser
AMAZON_SOURCE=auto
# Minutes between price refreshes (default for all retailers), and per retailer
REFRESH_MINUTES=45
REFRESH_MINUTES_MYNTRA=15

# Which payment offers you can actually use (comma-separated offer ids from data/offers.json)
MY_OFFERS=sbi-card,cb-1350-29k
# Count first-order-only coupons? (true/false)
INCLUDE_FIRST_ORDER=false

# --- Amazon (Creators API; needs an approved Amazon Associates account) -------------------
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
# The credential version Amazon shows with your keys, e.g. 2.2 or 3.2 (picks the token URL)
AMAZON_CREDENTIAL_VERSION=
# Only if Amazon gives you different endpoints:
AMAZON_TOKEN_URL=
AMAZON_API_BASE=https://creatorsapi.amazon/catalog/v1/
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_KEYWORDS=24k gold coin,gold bar 999,22k gold coin

# --- Public site (GitHub Pages) -------------------------------------------------------------
# Folder for `python -m goldtracker publish`; if it exists, the scheduler republishes after each refresh
PUBLISH_DIR=site
# Commit and push the site folder automatically after publishing (true/false)
PUBLISH_GIT_PUSH=false

# --- Telegram alerts (optional) -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_BELOW_PER_FINE_G=
